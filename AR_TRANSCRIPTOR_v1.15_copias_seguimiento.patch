+def safe_file_slug(value: str, fallback: str = "transcripcion") -> str:
+    value = re.sub(r"[^A-Za-z0-9_\-]+", "_", value.strip())
+    value = value.strip("._-")
+    return (value or fallback)[:70]
 
 
